# Stage 8 synthetic-only isolated pilot. TEMPLATE ONLY: DO NOT deploy as-is.
# Copy into a separately provisioned/private staging environment. Never commit live credentials.
DJANGO_SETTINGS_MODULE=ecoiq.settings_pilot
DEBUG=False
DJANGO_SECRET_KEY=REPLACE_WITH_NEW_RANDOM_STAGING_SECRET
DATABASE_URL=postgres://REPLACE_PILOT_USER:REPLACE_STAGING_SECRET@REPLACE_PRIVATE_STAGING_DB_HOST:5432/ecoiq_pilot_stage8
ALLOWED_HOSTS=pilot.ecoiq.example.invalid
CSRF_TRUSTED_ORIGINS=https://pilot.ecoiq.example.invalid
SITE_URL=https://pilot.ecoiq.example.invalid

# These attestations start FALSE until an operator manually verifies the real environment.
ECOIQ_PILOT_STAGING_MODE=false
ECOIQ_PILOT_SYNTHETIC_ONLY=false
ECOIQ_PILOT_PRIVATE_ACCESS_ATTESTED=false
ECOIQ_PILOT_DB_ISOLATION_ATTESTED=false
ECOIQ_PILOT_JOBS_DISABLED_ATTESTED=false
ECOIQ_PILOT_CACHE_ISOLATION_ATTESTED=false
ECOIQ_PILOT_EGRESS_BLOCK_ATTESTED=false

# Never turn any of these on for Stage 8.
AI_ENABLED=false
ECOIQ_GROUNDED_AI_EXTERNAL_ENABLED=false
AI_ALLOW_PAID_MODELS=false
AI_STAFF_MODEL_OVERRIDE_ENABLED=false
OPENROUTER_ENABLED=false
BYTEZ_ENABLED=false
NVIDIA_NIM_ENABLED=false
ECOIQ_BILLING_PROVIDER=none
STRIPE_LIVE_MODE_ALLOWED=false
CELERY_TASK_ALWAYS_EAGER=True
EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend

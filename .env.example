# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Django ────────────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-generate-a-real-key

DEBUG=True

# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank in local dev to use SQLite automatically.
# In production (Render), this is set automatically from the linked database.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── EcoIQ AI Gateway (ai_gateway app) ─────────────────────────────────────────
# One provider-neutral, FREE-ONLY AI system over OpenRouter, Bytez and NVIDIA
# NIM. EcoIQ selects the model automatically — there is no public model
# selector. Leaving every API key blank is safe:
# an unconfigured provider simply contributes no models.
#
# Global policy. AI_FREE_ONLY is the master switch — while it is true, paid
# models are neither displayed nor callable, and a free model failing can only
# ever fall back to another free model. Setting both AI_FREE_ONLY=true and
# AI_ALLOW_PAID_MODELS=true is refused at startup.
# Master on/off for the whole gateway (incident switch).
AI_ENABLED=true
AI_FREE_ONLY=true
AI_ALLOW_PAID_MODELS=false
# EcoIQ chooses the model. Normal users never see or send a model selection.
AI_MODEL_SELECTION_MODE=automatic
AI_ROUTING_MODE=automatic
# Staff may pin a model for benchmarking (registered free models only).
AI_STAFF_MODEL_OVERRIDE_ENABLED=true
# The public catch-all route — the LAST entry in the automatic chain,
# not the only possible model.
AI_DEFAULT_MODEL_KEY=openrouter:auto-free
AI_MODEL_CATALOG_CACHE_SECONDS=3600
AI_ALLOW_AUTOMATIC_FALLBACK=true
AI_MAX_PROVIDER_ATTEMPTS=3

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://ecoiq.ai
OPENROUTER_APP_NAME=EcoIQ
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_OUTPUT_TOKENS=1600
OPENROUTER_FREE_ROUTER_ENABLED=true
OPENROUTER_FREE_ROUTER_MODEL=openrouter/free
OPENROUTER_ZDR_ENABLED=true

# Bytez — ships with an EMPTY allowlist. See BYTEZ_APPROVED_MODELS below.
BYTEZ_ENABLED=true
BYTEZ_API_KEY=
BYTEZ_OPENAI_BASE_URL=https://api.bytez.com/models/v2/openai/v1
BYTEZ_MODELS_URL=https://api.bytez.com/models/v2/list/models
BYTEZ_TIMEOUT_SECONDS=60
BYTEZ_MAX_OUTPUT_TOKENS=1200
BYTEZ_FREE_ONLY=true
BYTEZ_ALLOW_PAID_CREDITS=false
BYTEZ_ALLOW_CLOSED_MODELS=false
# Curated Bytez allowlist, space- or comma-separated. Leave EMPTY until you
# have run, with a real key:
#   python manage.py refresh_ai_models --provider bytez --dry-run --explain
# and confirmed the ids against the catalogue it prints. Nothing is
# approved automatically.
BYTEZ_APPROVED_MODELS=

# NVIDIA NIM — Developer Program endpoints are PROTOTYPE/DEVELOPMENT access,
# not permanently free production inference. Both latches below must be flipped
# (and licensing separately approved) before NVIDIA models reach public traffic.
NVIDIA_NIM_ENABLED=true
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_TIMEOUT_SECONDS=60
NVIDIA_NIM_MAX_OUTPUT_TOKENS=1600
NVIDIA_NIM_PROTOTYPE_ONLY=true
NVIDIA_NIM_PUBLIC_PRODUCTION_ENABLED=false

# ── Hosts (production only) ───────────────────────────────────────────────────
# Space-separated: "myapp.onrender.com localhost"
ALLOWED_HOSTS=localhost 127.0.0.1

# Space-separated: "https://myapp.onrender.com"
CSRF_TRUSTED_ORIGINS=

# ── Backend Intelligence Engine (Celery + Redis) ──────────────────────────────
# Leave blank in local dev to use a plain local Redis instance
# (redis-server on localhost:6379 — the standard homebrew/apt default).
# In production, set to your Render Redis instance's internal connection URL.
REDIS_URL=

# Run `celery -A ecoiq worker --loglevel=info` in a separate terminal/process
# to actually execute queued tasks. Leave CELERY_TASK_ALWAYS_EAGER unset/False
# unless you specifically want .delay()/.apply_async() to run inline without
# a worker (e.g. a one-off script) — the test suite does not depend on this.
CELERY_TASK_ALWAYS_EAGER=False
